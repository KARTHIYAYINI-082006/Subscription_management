generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum ProductType {
  SERVICE
  GOODS
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum DiscountScope {
  SUBSCRIPTION
  PRODUCTS
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE
  ONLINE
}

model User {
  id                String         @id @default(cuid())
  name              String
  email             String         @unique
  passwordHash      String?
  role              Role           @default(CUSTOMER)
  isActive          Boolean        @default(true)
  phone             String?
  company           String?
  address           String?
  gstin             String?
  resetTokenHash    String?
  resetTokenExpires DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  subscriptions     Subscription[]
  invoices          Invoice[]

  @@index([role, createdAt])
}

model Tax {
  id          String    @id @default(cuid())
  name        String    @unique
  rate        Decimal   @db.Decimal(5, 2)
  description String?
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Product {
  id            String             @id @default(cuid())
  name          String
  type          ProductType        @default(SERVICE)
  salesPrice    Decimal            @db.Decimal(12, 2)
  costPrice     Decimal            @default(0) @db.Decimal(12, 2)
  description   String?
  createdAt     DateTime           @default(now())
  variants      ProductVariant[]
  taxes         Tax[]
  discounts     Discount[]
  lines         SubscriptionLine[]
  templateLines TemplateLine[]
}

model ProductVariant {
  id         String             @id @default(cuid())
  productId  String
  attribute  String
  value      String
  extraPrice Decimal            @default(0) @db.Decimal(12, 2)
  product    Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  lines      SubscriptionLine[]
}

model Plan {
  id            String              @id @default(cuid())
  name          String
  price         Decimal             @default(0) @db.Decimal(12, 2)
  billingPeriod BillingPeriod       @default(MONTHLY)
  minQuantity   Int                 @default(1)
  startDate     DateTime?           @db.Date
  endDate       DateTime?           @db.Date
  autoClose     Boolean             @default(false)
  closable      Boolean             @default(true)
  pausable      Boolean             @default(true)
  renewable     Boolean             @default(true)
  description   String?
  createdAt     DateTime            @default(now())
  subscriptions Subscription[]
  templates     QuotationTemplate[]
}

model QuotationTemplate {
  id           String         @id @default(cuid())
  name         String
  validityDays Int            @default(30)
  planId       String
  notes        String?
  createdAt    DateTime       @default(now())
  plan         Plan           @relation(fields: [planId], references: [id])
  lines        TemplateLine[]
}

model TemplateLine {
  id         String            @id @default(cuid())
  templateId String
  productId  String
  quantity   Int               @default(1)
  template   QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id])
}

model Subscription {
  id                  String             @id @default(cuid())
  number              String             @unique
  customerId          String
  planId              String
  status              SubscriptionStatus @default(DRAFT)
  startDate           DateTime           @db.Date
  expiryDate          DateTime?          @db.Date
  quotationValidUntil DateTime?          @db.Date
  paymentTermDays     Int                @default(15)
  nextInvoiceDate     DateTime?          @db.Date
  closedAt            DateTime?
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  customer            User               @relation(fields: [customerId], references: [id])
  plan                Plan               @relation(fields: [planId], references: [id])
  lines               SubscriptionLine[]
  invoices            Invoice[]

  @@index([status, nextInvoiceDate])
  @@index([customerId])
  @@index([createdAt])
}

model SubscriptionLine {
  id             String          @id @default(cuid())
  subscriptionId String
  productId      String
  variantId      String?
  quantity       Int             @default(1)
  unitPrice      Decimal         @db.Decimal(12, 2)
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

model Invoice {
  id             String        @id @default(cuid())
  number         String        @unique
  subscriptionId String
  customerId     String
  status         InvoiceStatus @default(DRAFT)
  periodStart    DateTime      @db.Date
  periodEnd      DateTime      @db.Date
  issueDate      DateTime      @db.Date
  dueDate        DateTime      @db.Date
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  discountName   String?
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  sentAt         DateTime?
  createdAt      DateTime      @default(now())
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])
  customer       User          @relation(fields: [customerId], references: [id])
  lines          InvoiceLine[]
  payments       Payment[]

  @@unique([subscriptionId, periodStart])
  @@index([status, dueDate])
  @@index([customerId])
  @@index([issueDate])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  date      DateTime      @db.Date
  note      String?
  createdAt DateTime      @default(now())
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([date])
}

model Discount {
  id          String        @id @default(cuid())
  name        String
  type        DiscountType
  value       Decimal       @db.Decimal(12, 2)
  scope       DiscountScope @default(SUBSCRIPTION)
  minPurchase Decimal       @default(0) @db.Decimal(12, 2)
  minQuantity Int           @default(0)
  maxDiscount Decimal?      @db.Decimal(12, 2)
  startDate   DateTime?     @db.Date
  endDate     DateTime?     @db.Date
  usageLimit  Int?
  usedCount   Int           @default(0)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  products    Product[]
}

model Counter {
  name  String @id
  value Int    @default(0)
}
