# Neon pooled connection (runtime) and direct connection (migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=verify-full"
# Optional: comma-separated public DNS resolvers used only if the system DNS cannot resolve a host
DNS_SERVERS=""
PORT=5000
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
# Comma-separated allowed frontend origins; the first one is used in email links
FRONTEND_URL="http://localhost:5173"
FIREBASE_PROJECT_ID="your-firebase-project-id"
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=you@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_FROM="Subvio <you@gmail.com>"
